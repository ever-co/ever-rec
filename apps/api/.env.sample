# EVER ID SIGN-IN (optional; leave EVER_ID_ISSUER_URL empty to keep it off)
# Any OpenID Connect issuer works. See "Sign in with Ever ID (optional)" in the README.
EVER_ID_ISSUER_URL=
EVER_ID_CLIENT_ID=
EVER_ID_CLIENT_SECRET=
EVER_ID_REDIRECT_URL=
EVER_ID_ALLOWED_ISSUERS=
EVER_ID_PLATFORM_PROJECT_ID=
EVER_ID_LINK_MODE=explicit
EVER_ID_SIGN_UP_ALLOWED=true
EVER_ID_BACKCHANNEL_LOGOUT_ENABLED=true
EVER_ID_LOGOUT_REVOKE_FIREBASE=false

# ANONYMOUS USAGE STATISTICS (on by default; see docs/ever-platform/anonymous-usage-statistics.md)
# One anonymous report a day about this installation as a whole: counts and feature switches only,
# never names, e-mails or files. EVER_STATS_ENABLED=false (exactly) turns it off entirely; the
# operator can also turn it off in Settings.
EVER_STATS_ENABLED=
# Where reports go (default: Ever Platform's public API; see the docs above).
EVER_STATS_API_URL=
# Two capital letters declared by the operator, or ZZ (undeclared).
EVER_STATS_COUNTRY=
# Tests only: seconds between reports (below 3600 only for a local EVER_STATS_API_URL).
EVER_STATS_SEND_INTERVAL_S=
# How this installation was set up: self-hosted (default), cloud, ever.sh, works_app, desktop or partner:<name>.
EVER_INSTALL_SOURCE=
# Firebase uids of further operators of this installation (comma separated), besides SUPER_ADMIN_ACCOUNT_UID.
EVER_OPERATOR_UIDS=
