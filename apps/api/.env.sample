# JWT SECRET
REC_JWT_SECRET=hard!To_find:my/GuyZ
REC_JWT_EXPIRES_IN=1h
REC_JWT_AUDIENCE=ever-rec
REC_JWT_ISSUER=rec-service

# EVER ID SIGN-IN (optional; leave EVER_ID_ISSUER_URL empty to keep it off)
# Any OpenID Connect issuer works. See "Sign in with Ever ID (optional)" in the README.
EVER_ID_ISSUER_URL=
EVER_ID_CLIENT_ID=
EVER_ID_CLIENT_SECRET=
EVER_ID_REDIRECT_URL=
EVER_ID_ALLOWED_ISSUERS=
EVER_ID_PLATFORM_PROJECT_ID=
EVER_ID_LINK_MODE=explicit
EVER_ID_SIGN_UP_ALLOWED=true
EVER_ID_BACKCHANNEL_LOGOUT_ENABLED=true
EVER_ID_LOGOUT_REVOKE_FIREBASE=false

# ANONYMOUS USAGE STATISTICS (on by default; see docs/ever-platform/anonymous-usage-statistics.md)
# One anonymous report a day about this installation as a whole: counts and feature switches only,
# never names, e-mails or files. EVER_STATS_ENABLED=false (exactly) turns it off entirely; the
# operator can also turn it off in Settings.
EVER_STATS_ENABLED=
# Where reports go (default: Ever Platform's public API; see the docs above).
EVER_STATS_API_URL=
# Two capital letters declared by the operator, or ZZ (undeclared).
EVER_STATS_COUNTRY=
# Tests only: seconds between reports (below 3600 only for a local EVER_STATS_API_URL).
EVER_STATS_SEND_INTERVAL_S=
# How this installation was set up: self-hosted (default), cloud, ever.sh, works_app, desktop or partner:<name>.
EVER_INSTALL_SOURCE=
# Firebase uids of further operators of this installation (comma separated), besides SUPER_ADMIN_ACCOUNT_UID.
EVER_OPERATOR_UIDS=

# EVER PLATFORM CONNECTION (off by default; see docs/ever-platform/ever-platform-connection.md)
# Connects this installation to an Ever Platform organization (ever.co/<handle>): verified plan and
# features per workspace, and the integrations an owner of that organization consents to in
# app.ever.co. Only EVER_CONNECT_ENABLED=true (exactly) loads it; unset, nothing is loaded and nothing
# is sent. Loaded, nothing is sent until the operator connects in Settings -> Ever Platform.
EVER_CONNECT_ENABLED=
# Optional: a connect code (EVC-XXXX-XXXX-XXXX) from app.ever.co, used once at the first start.
EVER_CONNECT_CODE=
# Integrations denied for every workspace (comma separated: instance_url, stats_link, ever_id_login,
# managed_operations).
EVER_CONNECT_INTEGRATIONS_DENY=
# How the event feed is read: longpoll (default) or interval (one read every 15 minutes).
EVER_CONNECT_FEED_MODE=
# The Ever Platform API (default https://api.ever.co); also read by the anonymous usage statistics.
EVER_PLATFORM_API_URL=
# Ever Rec cloud only: the provision routes app.ever.co hands a new workspace over to (the person
# confirms on a Rec screen). Off unless exactly true.
EVER_CONNECT_PROVISION_ENABLED=
