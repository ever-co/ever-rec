{
  "product": "rec",
  "compose": ["docker-compose.audit.yml"],
  "project": "ever-audit-rec",
  "api_service": "api",
  "process_services": ["api"],
  "services": ["api", "emulators"],
  "health_url": "http://api:3000/api/v1/",
  "health_timeout_s": 600,
  "module_routes": [
    "/api/v1/ever-stats/health",
    "/api/v1/ever-stats/status",
    "/api/v1/ever-stats/reports",
    "/api/v1/ever-stats/preview",
    "/api/v1/ever-stats/send",
    "/api/v1/ever-stats/enabled",
    "/api/v1/ever-stats/recount",
    "/api/v1/ever-stats/reset-identity"
  ],
  "adapter": "adapter.mjs",
  "wait_s": 150,
  "allowed_external_hosts": [
    "oauth2.googleapis.com",
    "www.googleapis.com",
    "firestore.googleapis.com",
    "identitytoolkit.googleapis.com",
    "securetoken.googleapis.com",
    "storage.googleapis.com",
    "firebasestorage.googleapis.com",
    "metadata.google.internal"
  ],
  "web_service": null,
  "no_web_reason": "This config is the API leg. The portal's browser leg has its own config (egress-audit.web.config.json): the portal's web server forwards /fonts/* to a fixed Ever host (apps/portal/next.config.js), a call older than the Ever Platform features that no setting turns off, so that leg cannot pass until the rewrite becomes configurable (see README.md)."
}
