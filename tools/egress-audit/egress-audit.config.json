{
  "product": "rec",
  "compose": ["docker-compose.audit.yml"],
  "project": "ever-audit-rec",
  "api_service": "api",
  "process_services": ["api"],
  "services": ["api", "emulators"],
  "health_url": "http://api:3000/api/v1/auth/ever-id/config",
  "health_timeout_s": 600,
  "module_routes": [
    "/api/v1/ever-stats/health",
    "/api/v1/ever-stats/status",
    "/api/v1/ever-stats/reports",
    "/api/v1/ever-stats/preview",
    "/api/v1/ever-stats/send",
    "/api/v1/ever-stats/enabled",
    "/api/v1/ever-stats/recount",
    "/api/v1/ever-stats/reset-identity",
    "/api/v1/ever-connect/health",
    "/api/v1/ever-connect/status"
  ],
  "adapter": "adapter.mjs",
  "wait_s": 150,
  "mock_config": {
    "codes": [
      {
        "code": "EVC-TEST-0000-0001",
        "kind": "connect",
        "product": "rec",
        "org": { "id": "01JMQCK0RG000000000000000A", "handle": "acme" },
        "expires_in_s": 900,
        "pending_approval": false
      }
    ]
  },
  "modes": {
    "connect_off_signin_on": {
      "description": "Connection off, statistics off, and Ever ID sign-in configured with an Ever-hosted issuer on an Ever-operated install: while nobody signs in, no Ever host is looked up and no call leaves (the sign-in provider never contacts its issuer on its own), and every module route answers 404.",
      "env": {
        "EVER_CONNECT_ENABLED": null,
        "EVER_STATS_ENABLED": "false",
        "EVER_INSTALL_SOURCE": "cloud",
        "EVER_ID_ISSUER_URL": "https://auth.ever.co",
        "EVER_ID_CLIENT_ID": "egress-audit-client",
        "EVER_ID_CLIENT_SECRET": "egress-audit-not-a-real-value",
        "EVER_ID_REDIRECT_URL": "http://api:3000/api/v1/auth/ever-id/callback"
      },
      "mock": false,
      "module_routes": "404",
      "browser": "negative",
      "allowed_rows": [],
      "required_rows": []
    }
  },
  "allowed_external_hosts": [
    "oauth2.googleapis.com",
    "www.googleapis.com",
    "firestore.googleapis.com",
    "identitytoolkit.googleapis.com",
    "securetoken.googleapis.com",
    "storage.googleapis.com",
    "firebasestorage.googleapis.com",
    "metadata.google.internal"
  ],
  "web_service": null,
  "no_web_reason": "This config is the API leg. The portal's browser leg has its own config (egress-audit.web.config.json): the portal's web server forwards /fonts/* to a fixed Ever host (apps/portal/next.config.js), a call older than the Ever Platform features that no setting turns off, so that leg cannot pass until the rewrite becomes configurable (see README.md)."
}
