{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid",
        ".write": "$userId === auth.uid",
        "whiteboardIds": {
          ".validate": false
        },
        "screenshots": {
          ".indexOn": [
            "parentId",
            "trash"
          ],
          ".read": "$userId === auth.uid",
          ".write": "$userId === auth.uid",
          "$itemId": {
            "uid": {
              ".validate": false
            },
            "likes": {
              ".validate": false
            }
          }
        },
        "videos": {
          ".indexOn": [
            "parentId",
            "trash"
          ],
          ".read": "$userId === auth.uid",
          ".write": "$userId === auth.uid",
          "$itemId": {
            "uid": {
              ".validate": false
            },
            "likes": {
              ".validate": false
            }
          }
        },
        "profile": {
          ".read": true,
          ".write": "$userId === auth.uid"
        }
      }
    },
    "shared": {
      ".indexOn": [
        "uidImageId",
        "uid"
      ],
      ".read": false,
      ".write": false
    },
    "sharedVideos": {
      ".indexOn": [
        "uidVideoId",
        "uid",
        "videoId"
      ],
      ".read": false,
      ".write": false
    },
    "sharedWorkspaceItems": {
      ".indexOn": [
        "queryField",
        "itemId"
      ],
      ".read": false,
      ".write": false
    },
    "whiteboards": {
      "mainCollection": {
        ".indexOn": ["admin"]
      },
      ".read": false,
      ".write": false
    },
    "ever_identities": {
      ".read": false,
      ".write": false
    },
    "ever_identities_by_uid": {
      ".read": false,
      ".write": false
    },
    "ever_id_pending": {
      ".indexOn": ["expiresAt"],
      ".read": false,
      ".write": false
    },
    "ever_id_pending_signup": {
      ".indexOn": ["expiresAt"],
      ".read": false,
      ".write": false
    },
    "ever_id_pending_connect": {
      ".indexOn": ["expiresAt"],
      ".read": false,
      ".write": false
    },
    "ever_id_handoff": {
      ".indexOn": ["expiresAt"],
      ".read": false,
      ".write": false
    },
    "ever_id_sessions": {
      ".indexOn": ["expiresAt", "subjectKey"],
      ".read": false,
      ".write": false
    },
    "ever_id_logout_jti": {
      ".indexOn": ["expiresAt"],
      ".read": false,
      ".write": false
    }
  }
}
